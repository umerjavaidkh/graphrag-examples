# Copy this file to .env and fill in your OpenAI key:  cp .env.example .env

# --- Neo4j ---
# Manual run (Neo4j on your host):     bolt://localhost:7687
# Docker Compose overrides this to     bolt://neo4j:7687 automatically,
# so you can leave the value below as-is for both workflows.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123

# --- OpenAI (required) ---
OPENAI_API_KEY=sk-...
